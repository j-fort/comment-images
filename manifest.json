{
  "manifest_version": 3,
  "name": "Comment Images",
  "version": "0.1",
  "description": "Show comment images on the website.",
  "permissions": [
    "activeTab"
  ],
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/main.js"],
      "matches": [
        "https://demonicscans.org/*"
      ]
    }
  ]
}
